datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  output          = "../lib/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

model Setting {
  id                                     String    @id @default(cuid())
  appName                                String    @default("Quiniela Mundial 2026")
  entryPriceUsd                          Float     @default(20)
  paymentPhone                           String    @default("04143043337")
  paymentNationalId                      String    @default("4561947")
  paymentBank                            String    @default("Banesco")
  zelleEmail                             String    @default("kissigloxxi@hotmail.com")
  exchangeRateCurrency                   String    @default("USD")
  manualExchangeRate                     Float?
  manualExchangeRateDate                 DateTime?
  firstPrizePercent                      Float     @default(65)
  secondPrizePercent                     Float     @default(20)
  organizationPercent                    Float     @default(15)
  deadline                               DateTime?
  rankingVisible                         Boolean   @default(true)
  showOnlyPaidParticipants               Boolean   @default(true)
  allowPublicPredictionViewAfterDeadline Boolean   @default(false)
  // Fixed exchange rate (replaces volatile BCV rate)
  fixedExchangeRate                      Float     @default(700)
  useFixedExchangeRate                   Boolean   @default(true)

  tiebreakerRules String @default("Por definir")

  // Pool status for managing quiniela phases
  poolStatus     String @default("OPEN")
  poolName       String @default("Quiniela Mundial 2026 - Fase de Grupos")
  poolPhase      String @default("GROUP_STAGE")
  nextPhaseLabel String @default("Octavos · Cuartos · Semifinales · Final")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id           String   @id @default(cuid())
  officialName String
  displayName  String
  shortName    String
  fifaCode     String   @unique
  isoCode      String
  flagEmoji    String   @default("")
  group        String
  aliases      String   @default("[]")
  createdAt    DateTime @default(now())

  matchesAsTeam1 Match[] @relation("Team1")
  matchesAsTeam2 Match[] @relation("Team2")
}

model Match {
  id              String       @id @default(cuid())
  matchNumber     Int          @unique
  group           String
  team1Id         String
  team2Id         String
  kickoffUtc      DateTime
  venue           String       @default("")
  city            String       @default("")
  source          String       @default("Excel import")
  status          MatchStatus  @default(SCHEDULED)
  team1Goals      Int?
  team2Goals      Int?
  result          MatchResult?
  resultUpdatedAt DateTime?
  resultSource    String? // 'manual' | 'auto_fifa' | 'auto_google' | 'auto_web'

  // Auto-detected result (pending admin review when confidence is not HIGH)
  autoDetectedTeam1Goals  Int?
  autoDetectedTeam2Goals  Int?
  autoDetectedResult      MatchResult?
  autoDetectedSource      String?
  autoDetectionConfidence String? // 'HIGH' | 'MEDIUM' | 'LOW'
  autoDetectedAt          DateTime?
  // 'CONFIRMED' | 'PENDING_REVIEW' | 'REJECTED' | null (manual)
  autoResultStatus        String?

  // Auto-check scheduling tracking
  lastAutoCheckAt   DateTime?
  autoCheckAttempts Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team1       Team         @relation("Team1", fields: [team1Id], references: [id])
  team2       Team         @relation("Team2", fields: [team2Id], references: [id])
  predictions Prediction[]
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum MatchResult {
  G1
  E
  G2
}

model Participant {
  id                String    @id @default(cuid())
  fullName          String
  nationalId        String    @unique
  phone             String
  email             String?
  city              String?
  participationCode String    @unique
  confirmationHash  String?
  submittedAt       DateTime?
  isComplete        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  predictions Prediction[]
  payment     Payment?
  ranking     RankingSnapshot?
}

model Prediction {
  id                  String      @id @default(cuid())
  participantId       String
  matchId             String
  predictedTeam1Goals Int
  predictedTeam2Goals Int
  predictedResult     MatchResult
  points              Int         @default(0)
  isExactScore        Boolean?
  isCorrectResult     Boolean?
  goalDifferenceError Int?
  createdAt           DateTime    @default(now())

  participant Participant @relation(fields: [participantId], references: [id])
  match       Match       @relation(fields: [matchId], references: [id])

  @@unique([participantId, matchId])
}

model Payment {
  id               String        @id @default(cuid())
  participantId    String        @unique
  paymentMethod    PaymentMethod @default(PAGO_MOVIL)
  amountUsd        Float         @default(20)
  exchangeRate     Float?
  exchangeRateDate DateTime?
  amountVes        Float?
  // Pago Móvil fields
  senderBank       String?
  // Zelle fields
  senderName       String?
  senderEmail      String?
  // Common fields
  paymentReference String?       @unique
  paymentDate      DateTime?
  paymentProofPath String?
  paymentStatus    PaymentStatus @default(PENDING)
  adminNotes       String?
  verifiedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  participant Participant @relation(fields: [participantId], references: [id])
}

enum PaymentMethod {
  PAGO_MOVIL
  ZELLE
}

enum PaymentStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

model RankingSnapshot {
  id                   String   @id @default(cuid())
  participantId        String   @unique
  totalPoints          Int      @default(0)
  exactScores          Int      @default(0)
  correctResults       Int      @default(0)
  wrongPredictions     Int      @default(0)
  pendingPredictions   Int      @default(0)
  playedMatches        Int      @default(0)
  totalGoalDiffError   Int      @default(0)
  effectivenessPercent Float    @default(0)
  currentPosition      Int      @default(0)
  previousPosition     Int?
  updatedAt            DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id])
}

model LiveResultsLog {
  id             String   @id @default(cuid())
  // CRON_RUN | RESULT_DETECTED | RESULT_CONFIRMED | RESULT_REJECTED | ERROR
  type           String
  message        String
  matchId        String?
  source         String?
  confidence     String?
  detectedGoals1 Int?
  detectedGoals2 Int?
  adminAction    String? // CONFIRMED | REJECTED | EDITED
  rawData        String? // JSON blob of raw fetched data
  createdAt      DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  eventType     String // PAGE_VIEW | RANKING_VIEW | MY_QUINIELA_VIEW | MATCH_PREDICTIONS_OPENED | RESULTS_VIEW | PARTICIPANT_LOOKUP | ADMIN_LOGIN | WHATSAPP_SHARE_CLICK | BACKUP_DOWNLOADED
  path          String
  visitorId     String? // anonymous browser-generated UUID
  participantId String?
  matchId       String?
  country       String?
  region        String?
  city          String?
  deviceType    String? // Mobile | Tablet | Desktop
  browser       String? // Chrome | Safari | Firefox | Edge | Otro
  ipHash        String? // SHA-256 of IP, truncated to 16 hex chars
  metadata      String? // JSON blob for extra context
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([visitorId])
}

// ── QUINIELA ELIMINATORIAS 2026 ──────────────────────────────────────────────
// Tablas independientes de la Fase de Grupos.

model KOParticipant {
  id                String    @id @default(cuid())
  fullName          String
  nationalId        String
  phone             String
  email             String?
  city              String?
  participationCode String    @unique
  phase             String    @default("R32")
  submittedAt       DateTime?
  isComplete        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  picks   KOPick[]
  payment KOPayment?
  ranking KORankingSnapshot?
}

model KOPayment {
  id               String        @id @default(cuid())
  participantId    String        @unique
  paymentMethod    PaymentMethod @default(PAGO_MOVIL)
  amountUsd        Float         @default(20)
  exchangeRate     Float?
  amountVes        Float?
  senderBank       String?
  senderName       String?
  senderEmail      String?
  paymentReference String?       @unique
  paymentDate      DateTime?
  paymentStatus    PaymentStatus @default(PENDING)
  adminNotes       String?
  verifiedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  participant KOParticipant @relation(fields: [participantId], references: [id])
}

model KOPick {
  id            String   @id @default(cuid())
  participantId String
  matchId       String
  homeGoals     Int
  awayGoals     Int
  penaltyWinner String?
  points        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participant KOParticipant @relation(fields: [participantId], references: [id])

  @@unique([participantId, matchId])
  @@index([matchId])
}

model KOMatchResult {
  id            String   @id
  homeGoals     Int?
  awayGoals     Int?
  penaltyWinner String?
  status        String   @default("SCHEDULED")
  updatedAt     DateTime @updatedAt
}

model KORankingSnapshot {
  id                String   @id @default(cuid())
  participantId     String   @unique
  phase             String   @default("R32")
  totalPoints       Int      @default(0)
  classifiedCorrect Int      @default(0)
  exactScores       Int      @default(0)
  penaltyBonus      Int      @default(0)
  playedMatches     Int      @default(0)
  currentPosition   Int      @default(0)
  previousPosition  Int?
  updatedAt         DateTime @updatedAt

  participant KOParticipant @relation(fields: [participantId], references: [id])
}
